# ─────────────────────────────────────────────────────────────
# NearMe Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ── PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearme
DB_USER=nearme_app
DB_PASSWORD=change_me_in_production
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false
# Set DB_SSL=true and provide the cert for production

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_256bit_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_different_256bit_secret
JWT_REFRESH_EXPIRES_IN=60d

# ── Security ──────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
# In production: ALLOWED_ORIGINS=https://nearme.app

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
# development | production

# ── Cron Jobs ─────────────────────────────────────────────────
CRON_ENABLED=true
CRON_CLEANUP_CACHE=0 3 * * *
CRON_CLEANUP_NOTIFICATIONS=0 4 * * *
CRON_CLEANUP_RATE_LIMITS=*/30 * * * *
CRON_GDPR_HARD_DELETE=0 2 * * *
CRON_POST_TOMBSTONES=0 5 * * *
CRON_OLD_REPORTS=0 6 1 * *
CRON_FEED_LOG=0 6 * * *

# ── Algorithm ─────────────────────────────────────────────────
FEED_MAX_RESULTS=50
FEED_CACHE_TTL_HOURS=24
PLACE_DETAIL_CACHE_TTL_HOURS=6
SEARCH_HISTORY_MAX=10

# ── Firebase (for JWT verification — optional integration) ────
FIREBASE_PROJECT_ID=nearme-prod
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
